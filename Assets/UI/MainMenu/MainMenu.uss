.menu-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: #0a0a14;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.15);
    picking-mode: ignore;
}

.content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px;
    opacity: 0;
    transition-duration: 1s;
    transition-property: opacity;
}

.content.show {
    opacity: 1;
}

.title-line {
    font-size: 64px;
    -unity-font-style: bold;
    color: #e8d5a3;
    -unity-text-align: middle-center;
    -unity-letter-spacing: 8px;
}

.title-line.subtitle {
    font-size: 32px;
    -unity-font-style: normal;
    color: #a09070;
    margin-bottom: 0;
    -unity-letter-spacing: 16px;
}

.divider {
    width: 120px;
    height: 2px;
    background-color: rgba(232, 213, 163, 0.4);
    margin: 30px 0;
}

.buttons-container {
    flex-direction: column;
    align-items: center;
}

.menu-button {
    font-size: 20px;
    -unity-font-style: bold;
    width: 260px;
    height: 52px;
    margin-bottom: 12px;
    background-color: rgba(232, 213, 163, 0.08);
    color: #e8d5a3;
    border-radius: 4px;
    border-color: rgba(232, 213, 163, 0.25);
    border-width: 1px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color;
}

.menu-button:hover {
    background-color: rgba(232, 213, 163, 0.18);
    border-color: rgba(232, 213, 163, 0.5);
}

.menu-button:active {
    background-color: rgba(232, 213, 163, 0.08);
    border-color: rgba(232, 213, 163, 0.3);
}

.version {
    font-size: 12px;
    color: rgba(160, 144, 112, 0.3);
    margin-top: 40px;
}
